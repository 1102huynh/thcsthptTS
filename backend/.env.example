# Copy this file to `.env` (git-ignored) and fill in real local values.
# Never commit the real `.env` file.

# Spring profile — "dev" is the default (see spring.profiles.active in
# application.yml) and only needs setting explicitly for "prod".
# SPRING_PROFILES_ACTIVE=dev

# MySQL (local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_management
DB_USERNAME=school_app
DB_PASSWORD=

# JWT — generate a real value with `openssl rand -base64 64`, required,
# no default: the app fails fast at startup if this is missing.
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
