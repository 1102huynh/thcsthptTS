<?xml version="1.0" encoding="UTF-8"?>
<!-- Static entry points for the public portal. Per-article / per-event URLs
     are added by a build step in a later phase (P4 - prerender); until then
     crawlers discover them by following links from /tin-tuc and /su-kien. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>/</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  <url><loc>/tin-tuc</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>/su-kien</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>/tuyen-sinh</loc><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <url><loc>/gioi-thieu</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
  <url><loc>/lien-he</loc><changefreq>monthly</changefreq><priority>0.5</priority></url>
</urlset>
